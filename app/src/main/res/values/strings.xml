    <string name="matrix_title">On the matrix</string>
    <string name="matrix_hide_title">Dark when nobody sees it</string>
    <string name="matrix_hide_text">The matrix goes out while the phone lies screen up or is in a pocket, and lights up again when you pick it up.</string>
    <string name="matrix_vibration_title">Vibration</string>
    <string name="matrix_vibration_text">The phone answers with a soft tap when you feed the pet, crack an egg, play or watch it grow. Never while it sleeps. Follows the system touch feedback setting.</string>
    <string name="matrix_notify_title">Wakes for notifications</string>
    <string name="matrix_notify_text">The pet looks up when a notification comes and shows a phone while a call is missed. Glyph Pet sees only the kind of a notification, never its text.</string>
    <string name="matrix_drop_text">Dropped the phone? The pet says ouch and wears a plaster until tomorrow.</string>
    <string name="matrix_drop_hurt">The phone was dropped: the pet wears a plaster until tomorrow morning.</string>

