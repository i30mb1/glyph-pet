    <string name="step_activate">Activate Glyph Pet in Glyph Toys</string>
    <string name="step_play">Hold the Glyph button to feed, rock the phone gently to play, shake it to grow a pet that is ready</string>
    <string name="step_aod">Set it as the Always-on Glyph Toy to keep it with you</string>

    <string name="intro_1_title">A new pet every day</string>
    <string name="intro_1_text">Every day you play, a new pet comes as an egg, always one you do not have yet. Put it on the matrix and press the Glyph button five times: it hatches.</string>
    <string name="intro_2_title">A button and gestures</string>
    <string name="intro_2_text">The pet lives on the back of your phone. Hold the Glyph button to feed it, rock the phone gently to play. A shake makes it dizzy, or grows it once it is ready.</string>
    <string name="intro_3_title">Collect all 28</string>
    <string name="intro_3_text">Every new pet joins your nursery. Nine are common, thirteen rare, four legendary and two mythic.</string>
    <string name="intro_next">Next</string>
    <string name="intro_start">Start</string>

